{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "apps", "vite.config.ts", "vite.report.config.ts", "vite.cli.config.ts", "vitest.config.ts"],
  "exclude": ["src/**/*.test.ts", "apps/**/*.test.ts"]
}
